{
  "name": "confluence-change-analyzer",
  "version": "0.1.0",
  "description": "Chrome-расширение (MV3) для анализа истории изменений страниц Confluence, подсветки и экспорта в Word",
  "private": true,
  "scripts": {
    "dev": "webpack --mode development --watch",
    "build": "webpack --mode production",
    "clean": "rimraf dist",
    "test:e2e": "node test/e2e/run.cjs"
  },
  "dependencies": {
    "dayjs": "^1.11.13",
    "docx": "^9.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.4",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^7.1.2",
    "mini-css-extract-plugin": "^2.9.1",
    "playwright": "^1.56.1",
    "rimraf": "^6.0.1",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4"
  },
  "browserslist": [
    "last 2 Chrome versions"
  ]
}
